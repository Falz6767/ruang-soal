generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Question {
  id          String   @id @default(cuid())
  grade       Int
  subject     String
  topic       String?
  type        String
  text        String
  options     String   @default("[]")
  answer      String
  explanation String?
  isExample   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       WorksheetItem[]

  @@index([grade, subject, type])
}

model Worksheet {
  id           String          @id @default(cuid())
  title        String
  instructions String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  items        WorksheetItem[]
}

model WorksheetItem {
  id          String    @id @default(cuid())
  worksheetId String
  questionId  String?
  position    Int
  snapshot    String
  worksheet   Worksheet @relation(fields: [worksheetId], references: [id], onDelete: Cascade)
  question    Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@unique([worksheetId, position])
  @@index([questionId])
}
