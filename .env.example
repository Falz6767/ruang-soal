# Saat deploy, isi kedua variabel pada Vercel Environment Variables.
# Gunakan URL pooled dari penyedia PostgreSQL untuk DATABASE_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ruang_soal?schema=public&connection_limit=1"
# Gunakan URL direct/non-pooled untuk migrasi skema.
POSTGRES_URL="postgresql://postgres:postgres@localhost:5432/ruang_soal?schema=public"
NEXT_TELEMETRY_DISABLED=1
