{
  "name": "ruang-soal",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=22.12.0 <25" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build --webpack",
    "vercel-build": "prisma generate && prisma migrate deploy && next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "check": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "test:api": "node tests/api-smoke.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "lucide-react": "0.468.0",
    "next": "16.4.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@tailwindcss/postcss": "4.3.3",
    "postcss": "8.5.30",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "prisma": { "seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts" },
  "overrides": { "deepmerge-ts": "8.0.0" }
}
